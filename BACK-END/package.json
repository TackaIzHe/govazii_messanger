{
  "name": "messanger",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "init": "tsc --init",
    "run": "ts-node ./src/index.ts",
    "dev": "nodemon ./src/index.ts",
    "test_dev": "PROTO=\"http\" HOST=\"localhost\" nodemon ./src/index.ts",
    "test_api": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" npx jest",
    "init-cert-for-https": "mkdir cert && npm run init-key && npm run init-csr && npm run init-cert",
    "init-key": "openssl genrsa -out ./cert/key.pem",
    "init-csr": "openssl req -new -key ./cert/key.pem -out ./cert/csr.pem",
    "init-cert": "openssl x509 -req -days 365 -in ./cert/csr.pem -signkey ./cert/key.pem -out ./cert/cert.pem"
  },
  "devDependencies": {
    "@types/axios": "^0.9.36",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie": "^0.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.2.3",
    "@types/socket.io": "^3.0.1",
    "axios": "^1.21.0",
    "nodemon": "^3.1.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@types/multer": "^2.0.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jest": "^30.5.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "nodemailer": "^8.0.1",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.8.3",
    "sqlite3": "^5.1.7",
    "typeorm": "^0.3.28"
  }
}
